DATABASE_URL=postgresql://postgres:change-me@localhost:5432/livestock_db
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=development
DEBUG=true
SQL_ECHO=false
CORS_ORIGINS=http://localhost:3000,http://localhost:19006
CORS_ALLOW_CREDENTIALS=true
EXPOSE_INTERNAL_ERRORS=false
SCHEDULER_ENABLED=false
SCHEDULER_HOUR=1
SCHEDULER_MINUTE=0
# Nominal 15-second prototype; keep historical artifacts unchanged.
BINARY_V2_ENABLED=true
BINARY_V3_ENABLED=false
MODEL_15S_ENABLED=true
MODEL_15S_PATH=ml/models/behavior_classifier_v3_staged.pkl
# Required before anomaly conclusions on newly qualified measurement days.
ANOMALY_MIN_COVERAGE_SECONDS=
